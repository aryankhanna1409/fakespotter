# Copy to .env (which is git-ignored) and fill in. fakespotter reads it automatically.
# Create a "script" app at https://www.reddit.com/prefs/apps to get these.
REDDIT_CLIENT_ID=your-client-id
REDDIT_CLIENT_SECRET=your-client-secret
# Optional, but Reddit asks clients to identify themselves:
REDDIT_USER_AGENT="FakeSpotter/1.0 (by u/your-username)"
